{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src", "src/ui/env.d.ts", "vite.config.ts", "extensions/pi"]
}
